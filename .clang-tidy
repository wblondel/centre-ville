# Analyse statique du C++ (tools/lint_cpp.py, job « Lint C++ » de la CI).
# Tout constat fait échouer la CI : il n'y a pas de liste de constats tolérés.
# Fausse alerte : // NOLINT(regle) ou // NOLINTNEXTLINE(regle), avec le motif sur la même ligne.
#
# Familles actives : bogues, CERT, analyseur statique, concurrence, C++ Core Guidelines,
# divers, modernisation, performance, portabilité et lisibilité.
#
# Règles retirées, avec leur motif :
#  - bugprone-easily-swappable-parameters : (x, y) dans toutes les signatures de la grille ;
#  - bugprone-signed-bitwise : les directions (dirposs) sont des masques de bits positifs sur
#    des entiers, défini en C++20 ;
#  - cppcoreguidelines-avoid-do-while : les macros de Catch2 et de Qt Test en sont faites ;
#  - cppcoreguidelines-avoid-magic-numbers, readability-magic-numbers : coordonnées des
#    fiches (celles des .dfm) et constantes des règles de la simulation, commentées sur place ;
#  - cppcoreguidelines-avoid-non-const-global-variables : une instance par fiche
#    (frmSimulation...), la simulation (cv) et sa vue (vue), comme dans l'original ;
#  - cppcoreguidelines-non-private-member-variables-in-classes,
#    misc-non-private-member-variables-in-classes : les classes du moteur sont les données de
#    la simulation, lues par les fiches et écrites champ par champ dans les .cvw ;
#  - cppcoreguidelines-owning-memory : demande la GSL (gsl::owner) ; les widgets Qt
#    appartiennent à leur parent ;
#  - cppcoreguidelines-pro-bounds-constant-array-index,
#    cppcoreguidelines-pro-bounds-avoid-unchecked-container-access : gsl::at ou .at() à chaque
#    indice ; les bornes sont vérifiées par les tests sous ASan et UBSan ;
#  - cppcoreguidelines-use-enum-class : les énumérés du moteur servent d'indices et
#    d'entiers dans les calculs, et sont sérialisés tels quels ;
#  - misc-no-recursion : calcul récursif des distances (borné par la taille de la zone) et
#    infections chaînées ;
#  - modernize-use-trailing-return-type : simple style ;
#  - performance-enum-size : la taille des énumérés fait partie du format .cvw ;
#  - readability-function-cognitive-complexity, readability-function-size : les règles de la
#    simulation sont de longues fonctions, que les découper changerait trop ;
#  - readability-identifier-length : x, y, d, i sont les noms naturels de la grille ;
#  - readability-trailing-comma : simple style, et clang-format met alors un élément par ligne.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-use-enum-class,
  -misc-no-recursion,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-identifier-length,
  -readability-trailing-comma
CheckOptions:
  # if (pointeur) reste idiomatique ; les entiers sont comparés explicitement
  readability-implicit-bool-conversion.AllowPointerConditions: true
  # Symboles non vérifiés : ceux de Qt (<QWidget> inclut qwidget.h) et ceux des en-têtes internes du
  # système, propres à chaque plateforme (<sys/_types/_off_t.h> sous macOS, <bits/...> sous Linux)
  misc-include-cleaner.IgnoreHeaders: '.*/Qt[A-Za-z]*/.*;.*/Qt[A-Za-z]*\.framework/.*;q[a-z0-9_]*\.h;sys/.*;bits/.*;.*/_types/.*;asm.*/.*;linux/.*;mach/.*;signal\.h;unistd\.h;fcntl\.h'
  # X-macros générées depuis les .dfm (composants et événements des fiches) et static_assert de
  # format_cvw.h, qui ont besoin du préprocesseur (# pour le nom du champ dans le message)
  cppcoreguidelines-macro-usage.AllowedRegexp: '^(COMPOSANTS|EVENEMENTS)_|^(CONNECTE_EVENEMENT|LIE_COMPOSANT|CVW_ENUM_OCTET|CVW_CHAMP)$'
  # Les propriétés de la VCL (Propriete<T>) s'affectent à travers un pointeur vers un contrôle :
  # l'analyse les prend pour des lectures
  misc-const-correctness.WarnPointersAsPointers: false
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
HeaderFilterRegex: '(engine|app|tests)/.*\.h$'
ExcludeHeaderFilterRegex: '(^|/)build/'
